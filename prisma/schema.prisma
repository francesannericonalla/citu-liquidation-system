generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  Encoder
  Admin
}

enum ApprovalStatus {
  pending_email_verification
  pending_office_approval
  active
  rejected
}

enum AccountStatus {
  active
  deactivated
}

enum LiquidationStatus {
  draft
  generated
  submitted_to_fao
  completed
}

enum DocType {
  receipt
  certification
  acknowledgement_receipt
}

enum ReasonTemplate {
  honorarium
  raffle_prize
  custom
}

// ── Models ────────────────────────────────────────────────────────────────────

model Office {
  id                 String        @id @default(uuid())
  name               String
  short_code         String        @unique
  default_categories Json
  users              User[]        @relation("OfficeUsers")
  pending_requests   User[]        @relation("RequestedOffice")
  liquidations       Liquidation[]
}

model User {
  id                  String         @id @default(uuid())
  name                String
  office              Office?        @relation("OfficeUsers", fields: [office_id], references: [id])
  office_id           String?
  role                Role
  cit_email           String         @unique
  password_hash       String
  email_verified_at   DateTime?
  requested_office    Office?        @relation("RequestedOffice", fields: [requested_office_id], references: [id])
  requested_office_id String?
  approval_status     ApprovalStatus @default(pending_email_verification)
  approved_by_user    User?          @relation("ApprovedBy", fields: [approved_by], references: [id])
  approved_by         String?
  approved_users      User[]         @relation("ApprovedBy")
  approved_at         DateTime?
  account_status      AccountStatus  @default(active)

  liquidations_created     Liquidation[] @relation("CreatedBy")
  liquidations_last_edited Liquidation[] @relation("LastEditedBy")
}

model Liquidation {
  id                    String            @id @default(uuid())
  office                Office            @relation(fields: [office_id], references: [id])
  office_id             String
  pr_number             String
  payer_name            String
  date                  DateTime          @db.Date
  project_name          String
  college_dept          String
  approved_budget_total Decimal           @db.Decimal(12, 2)
  cv_cdv_number         String?
  cv_cdv_date           DateTime?         @db.Date
  claimant_name         String
  dean_head_name        String
  status                LiquidationStatus @default(draft)
  created_by_user       User              @relation("CreatedBy", fields: [created_by], references: [id])
  created_by            String
  last_edited_by_user   User              @relation("LastEditedBy", fields: [last_edited_by], references: [id])
  last_edited_by        String
  deleted_at            DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  expense_categories    ExpenseCategory[]
  certification_entries CertificationEntry[]
}

model ExpenseCategory {
  id                     String        @id @default(uuid())
  liquidation            Liquidation   @relation(fields: [liquidation_id], references: [id])
  liquidation_id         String
  name                   String
  approved_budget_amount Decimal       @db.Decimal(12, 2)
  sort_order             Int
  expense_items          ExpenseItem[]
}

model ExpenseItem {
  id            String          @id @default(uuid())
  category      ExpenseCategory @relation(fields: [category_id], references: [id])
  category_id   String
  payee         String
  amount        Decimal         @db.Decimal(12, 2)
  doc_type      DocType
  doc_reference String?

  certification_entry     CertificationEntry?
  acknowledgement_receipt AcknowledgementReceipt?
}

model CertificationEntry {
  id              String      @id @default(uuid())
  liquidation     Liquidation @relation(fields: [liquidation_id], references: [id])
  liquidation_id  String
  expense_item    ExpenseItem @relation(fields: [expense_item_id], references: [id])
  expense_item_id String      @unique
  reason          String
}

model AcknowledgementReceipt {
  id              String         @id @default(uuid())
  expense_item    ExpenseItem    @relation(fields: [expense_item_id], references: [id])
  expense_item_id String         @unique
  amount_in_words String
  reason_template ReasonTemplate
  reason_text     String
  event_name      String
  event_dates     String
  venue           String
}

// ── Auth tokens ───────────────────────────────────────────────────────────────

model VerificationToken {
  id      String   @id @default(uuid())
  userId  String   @unique
  token   String   @unique
  expires DateTime
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  userId  String   @unique
  token   String   @unique
  expires DateTime
}
