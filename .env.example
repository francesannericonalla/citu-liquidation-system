# Copy this file to .env and fill in the values.
#
# LOCAL DEV (Docker Compose)
#   Both URLs point to the same container — no pgbouncer locally.
#   Host port 5433 is used to avoid conflict with any local PostgreSQL install.
#
# PRODUCTION (Supabase)
#   DATABASE_URL = pooled connection  (port 6543, append ?pgbouncer=true)
#   DIRECT_URL   = direct connection  (port 5432) — used only by prisma migrate

DATABASE_URL="postgresql://citu:citu_dev_password@localhost:5433/citu_liquidation"
DIRECT_URL="postgresql://citu:citu_dev_password@localhost:5433/citu_liquidation"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change_me_in_production_32chars_minimum"

RESEND_API_KEY=""

# Docker Compose overrides (only needed if you change the defaults)
POSTGRES_USER="citu"
POSTGRES_PASSWORD="citu_dev_password"
POSTGRES_DB="citu_liquidation"
